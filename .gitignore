# -----------------------------------------------------------------------------
# OS-specific files
.DS_Store
Thumbs.db

# IDE / Editor configuration
.idea/
.vscode/
.spyderproject
.spyproject
.ropeproject

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Environments
.env
.venv
env/
venv/
.conda/
*.envrc

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# Test & Coverage Reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------------
# Local Terraform directories and state
.terraform/
*.tfstate
*.tfstate.*

# NEVER commit variable definition files.
# These often contain environment-specific values or secrets.
*.tfvars

# Plan files
*.tfplan

# -----------------------------------------------------------------------------
# Geyser Genomics Project Specific
# -----------------------------------------------------------------------------
# Local data, logs, and other transient directories from testing
data/
logs/
dags/
plugins/
results/
tmp/
prototypes/


# Ignore large genomic data files
# These should live in S3, not the Git repository.
*.fastq.gz
*.fq.gz
*.bam
*.cram
*.vcf.gz

# Ignore temporary data exports (e.g., from CloudWatch)
*.csv
# ...except the benchmark history and its figure CSV (aggregate hap.py numbers, no genomic data; #58)
!docs/benchmarks/*.csv

# -----------------------------------------------------------------------------
# Local utility scripts / prototypes (not tracked in Git)
# -----------------------------------------------------------------------------
import.sh
origninal_claude logic.py   # dashboard prototype, keep local only
scripts/migrations/*.json   # migration input/mapping files

# -----------------------------------------------------------------------------
# Output / artifacts
# -----------------------------------------------------------------------------
*.log
*.out
*.tmp

# -----------------------------------------------------------------------------
# Infra scratch files
# -----------------------------------------------------------------------------
infrastructure/query.json

# Terraform plans and vars
infrastructure/tfplan-*
*.tfplan
*.tfvars

# Offline pipeline runs (scripts/run_local.py, scripts/make_test_data.py)
local_bucket/
