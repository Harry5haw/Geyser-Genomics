# Terraform renders infrastructure/*.json into resources (templatefile): a CRLF checkout (Windows,
# core.autocrlf=true) would change the deployed definition by whitespace and show drift in every plan.
infrastructure/** text eol=lf
# The trigger Lambda's zip is built from lambda/trigger/index.py (archive_file): the same CRLF problem.
lambda/** text eol=lf
# Shell scripts run inside Linux images (app-publish/entrypoint.sh is an ENTRYPOINT): a CRLF checkout breaks the
# shebang ("exec ...: no such file or directory") in any image built on Windows.
*.sh text eol=lf
# Browser scripts: the published bytes (and the renderer's size budget, web/tests/test_web_figures.py) are the LF
# ones; a CRLF checkout would ship and measure different files from images built on Windows.
*.js text eol=lf
