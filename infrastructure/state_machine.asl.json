{
  "Comment": "Geyser Genomics pipeline: QC and alignment in parallel from the raw reads, then variant calling scattered by region (a Map over the planned regions) and merged. Every job gets RUN_NAME = the execution name, which the stages write into the run record (app/provenance.py). Per-stage sizes, the run time limit and Batch API retries come from step_functions.tf (#104); the job definition retries infrastructure failures. Rendered by step_functions.tf with templatefile(); tests/test_state_machine_local.py runs this same file in Step Functions Local.",
  "StartAt": "Check_Gate_Profile",
  "TimeoutSeconds": ${pipeline_timeout_seconds},
  "States": {
    "Check_Gate_Profile": {
      "Type": "Choice",
      "Comment": "The quality gate's thresholds for this run (#157): gate_profile in the input (the trigger sets it from the upload's S3 metadata gate-profile). None: default. Checked first, so an unknown profile fails the run before any job starts, never falling back to the default silently.",
      "Choices": [
        { "Not": { "Variable": "$.gate_profile", "IsPresent": true }, "Next": "Default_Gate_Profile" },
        {
          "Or": [
            { "Variable": "$.gate_profile", "StringEquals": "default" },
            { "Variable": "$.gate_profile", "StringEquals": "synthetic" },
            { "Variable": "$.gate_profile", "StringEquals": "smoke" }
          ],
          "Next": "Check_Reference_Name"
        }
      ],
      "Default": "Prepare_Profile_Error"
    },
    "Default_Gate_Profile": {
      "Type": "Pass",
      "Result": "default",
      "ResultPath": "$.gate_profile",
      "Next": "Check_Reference_Name"
    },
    "Prepare_Profile_Error": {
      "Type": "Pass",
      "Comment": "An unknown gate_profile, in either gate_mode: an operator mistake, like a mistyped GATE_MODE. JsonToString, so any value (even not a string) gives the message.",
      "Parameters": {
        "Error": "UnknownGateProfile",
        "Cause.$": "States.Format('gate_profile {} is not one of: default, synthetic, smoke (thresholds in the image, gate/thresholds/)', States.JsonToString($.gate_profile))"
      },
      "ResultPath": "$.error",
      "Next": "Prepare_Run_Close"
    },
    "Check_Reference_Name": {
      "Type": "Choice",
      "Comment": "The reference genome for this run: reference_name in the input (the trigger sets it from the upload's S3 metadata reference, else REFERENCE_NAME or chr20.fa). It must be a plain file name under reference/ (a non-empty string without a slash). Anything else, including what the trigger flags (mates that disagree, a misspelt metadata key, unreadable metadata), fails the run before any job starts.",
      "Choices": [
        { "Not": { "Variable": "$.reference_name", "IsPresent": true }, "Next": "Prepare_Reference_Missing" },
        {
          "And": [
            { "Variable": "$.reference_name", "IsString": true },
            { "Not": { "Variable": "$.reference_name", "StringEquals": "" } },
            { "Not": { "Variable": "$.reference_name", "StringMatches": "*/*" } }
          ],
          "Next": "Check_Reference"
        }
      ],
      "Default": "Prepare_Reference_Error"
    },
    "Prepare_Reference_Missing": {
      "Type": "Pass",
      "Comment": "A manual start without reference_name (the trigger always sets one). Its own state, because the Cause in Prepare_Reference_Error can't read a path that isn't there.",
      "Parameters": {
        "Error": "UnknownReference",
        "Cause": "The input has no reference_name (a file name under reference/ in the data lake)"
      },
      "ResultPath": "$.error",
      "Next": "Prepare_Run_Close"
    },
    "Prepare_Reference_Error": {
      "Type": "Pass",
      "Comment": "JsonToString, so any value (a list from mates that disagree, an object the trigger flagged, a number) gives the message.",
      "Parameters": {
        "Error": "UnknownReference",
        "Cause.$": "States.Format('reference_name {} is not a file name under reference/ (a non-empty string without a slash)', States.JsonToString($.reference_name))"
      },
      "ResultPath": "$.error",
      "Next": "Prepare_Run_Close"
    },
    "Check_Reference": {
      "Type": "Task",
      "Comment": "The reference must exist before any job starts: a HeadObject on reference/<name> (metadata only, nothing is downloaded). Its indexes may be missing, since align builds them. A missing key is S3.NoSuchKeyException (the role has s3:ListBucket, so S3 answers 404, not 403) and is not retried.",
      "Resource": "arn:aws:states:::aws-sdk:s3:headObject",
      "Parameters": {
        "Bucket": "${bucket}",
        "Key.$": "States.Format('reference/{}', $.reference_name)"
      },
      "ResultPath": null,
      "Retry": [
        { "ErrorEquals": ["S3.S3Exception", "States.Timeout"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Prepare_Reference_Not_Found", "ResultPath": "$.reference_error" }
      ],
      "Next": "Run_Setting_Rules"
    },
    "Prepare_Reference_Not_Found": {
      "Type": "Pass",
      "Parameters": {
        "Error": "ReferenceNotFound",
        "Cause.$": "States.Format('reference/{} could not be read from ${bucket} ({}). Upload the FASTA there, or name another reference in the upload metadata (reference=<name>)', $.reference_name, $.reference_error.Error)"
      },
      "ResultPath": "$.error",
      "Next": "Prepare_Run_Close"
    },
    "Run_Setting_Rules": {
      "Type": "Pass",
      "Comment": "Per-run size overrides (cost x turnaround grid, docs/figures/cost-surface-grid.md): an optional object overrides in the input, e.g. {\"align_vcpu\": \"2\", \"align_memory_mb\": \"4096\", \"variant_region_window\": 17000000}, merged over these Terraform defaults. Uploads never set it, so triggered runs use the defaults. align_sizes: the Fargate vCPU/MiB pairs align may use (step_functions.tf: valid pairs where max(qc, plan) + align fits in fargate_max_vcpus).",
      "Result": {
        "defaults": {
          "align_vcpu": "${align_vcpu}",
          "align_memory_mb": "${align_memory_mb}",
          "variant_region_window": ${variant_region_window}
        },
        "setting_count": 3,
        "align_sizes": ${align_sizes},
        "window_min": ${variant_region_window_min},
        "window_max": ${variant_region_window_max}
      },
      "ResultPath": "$.run_rules",
      "Next": "Check_Run_Overrides"
    },
    "Check_Run_Overrides": {
      "Type": "Choice",
      "Comment": "Every check below runs before any intrinsic that could fail on the value: an intrinsic that fails in a Pass state ends the run with States.Runtime, which nothing can catch (no record, no notification).",
      "Choices": [{ "Not": { "Variable": "$.overrides", "IsPresent": true }, "Next": "No_Run_Overrides" }],
      "Default": "Inspect_Run_Overrides"
    },
    "No_Run_Overrides": {
      "Type": "Pass",
      "Result": {},
      "ResultPath": "$.overrides",
      "Next": "Inspect_Run_Overrides"
    },
    "Inspect_Run_Overrides": {
      "Type": "Pass",
      "Comment": "JsonToString works on any value, so this is safe for a list, a number or null; only an object goes on to the merge.",
      "Parameters": { "text.$": "States.JsonToString($.overrides)" },
      "ResultPath": "$.run_check",
      "Next": "Check_Run_Overrides_Object"
    },
    "Check_Run_Overrides_Object": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.run_check.text", "StringMatches": "{*", "Next": "Apply_Run_Overrides" }],
      "Default": "Prepare_Run_Overrides_Error"
    },
    "Apply_Run_Overrides": {
      "Type": "Pass",
      "Comment": "The overrides win over the defaults. Unknown keys: the state machine can't list an object's keys, but the merged object has exactly setting_count comma-separated parts only if overrides adds no key (no valid value contains a comma), so a misspelt key (align_cpu) fails instead of running the default silently.",
      "Parameters": {
        "settings.$": "States.JsonMerge($.run_rules.defaults, $.overrides, false)",
        "parts.$": "States.ArrayLength(States.StringSplit(States.JsonToString(States.JsonMerge($.run_rules.defaults, $.overrides, false)), ','))"
      },
      "ResultPath": "$.run_check",
      "Next": "Check_Run_Setting_Types"
    },
    "Check_Run_Setting_Types": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.run_check.parts", "NumericEqualsPath": "$.run_rules.setting_count" },
            { "Variable": "$.run_check.settings.align_vcpu", "IsString": true },
            { "Variable": "$.run_check.settings.align_memory_mb", "IsString": true },
            { "Variable": "$.run_check.settings.variant_region_window", "IsNumeric": true }
          ],
          "Next": "Inspect_Run_Setting_Values"
        }
      ],
      "Default": "Prepare_Run_Overrides_Error"
    },
    "Inspect_Run_Setting_Values": {
      "Type": "Pass",
      "Comment": "Types are known to be safe here. The window as text: tasks.py needs a whole number, and a JSON number with a fraction or exponent (5.0E7) prints with a . or an E.",
      "Parameters": {
        "settings.$": "$.run_check.settings",
        "align_size_ok.$": "States.ArrayContains($.run_rules.align_sizes, States.Format('{}/{}', $.run_check.settings.align_vcpu, $.run_check.settings.align_memory_mb))",
        "window_text.$": "States.Format('{}', $.run_check.settings.variant_region_window)"
      },
      "ResultPath": "$.run_check",
      "Next": "Check_Run_Setting_Values"
    },
    "Check_Run_Setting_Values": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.run_check.align_size_ok", "BooleanEquals": true },
            { "Variable": "$.run_check.settings.variant_region_window", "NumericGreaterThanEqualsPath": "$.run_rules.window_min" },
            { "Variable": "$.run_check.settings.variant_region_window", "NumericLessThanEqualsPath": "$.run_rules.window_max" },
            { "Not": { "Variable": "$.run_check.window_text", "StringMatches": "*.*" } },
            { "Not": { "Variable": "$.run_check.window_text", "StringMatches": "*E*" } },
            { "Not": { "Variable": "$.run_check.window_text", "StringMatches": "*e*" } }
          ],
          "Next": "Set_Run_Settings"
        }
      ],
      "Default": "Prepare_Run_Overrides_Error"
    },
    "Set_Run_Settings": {
      "Type": "Pass",
      "Comment": "What this run uses (also in the execution's output): align's size, and the window the planner and the merge both get, as the text tasks.py reads.",
      "Parameters": {
        "align_vcpu.$": "$.run_check.settings.align_vcpu",
        "align_memory_mb.$": "$.run_check.settings.align_memory_mb",
        "variant_region_window.$": "$.run_check.window_text"
      },
      "ResultPath": "$.run_settings",
      "Next": "QC_and_Align"
    },
    "Prepare_Run_Overrides_Error": {
      "Type": "Pass",
      "Comment": "Invalid overrides fail the run before any job, like an unknown gate_profile: never a silent default. Only JsonToString and plain numbers here, so this Pass can't fail.",
      "Parameters": {
        "Error": "InvalidRunOverrides",
        "Cause.$": "States.Format('overrides {} are not valid. Allowed keys: align_vcpu and align_memory_mb (strings, one of the Fargate pairs {}) and variant_region_window (a whole number from {} to {})', States.JsonToString($.overrides), States.JsonToString($.run_rules.align_sizes), $.run_rules.window_min, $.run_rules.window_max)"
      },
      "ResultPath": "$.error",
      "Next": "Prepare_Run_Close"
    },
    "QC_and_Align": {
      "Type": "Parallel",
      "Comment": "QC and align read raw_reads/ directly and don't depend on each other; If either fails, Step Functions stops the other and the Catch below handles it. If either fails, Step Functions stops the other and the Catch below handles it.",
      "Branches": [
        {
          "StartAt": "Prepare_QC_Command",
          "States": {
            "Prepare_QC_Command": {
              "Type": "Pass",
              "Parameters": {
                "JobName.$": "States.Format('QualityControl-{}-{}', $.srr_id, $$.Execution.Name)",
                "ContainerOverrides": {
                  "Command.$": "States.Array('python', 'tasks.py', 'qc', $.srr_id)",
                  "Environment": [{ "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" }],
                  "ResourceRequirements": [
                    { "Type": "VCPU", "Value": "${qc_vcpu}" },
                    { "Type": "MEMORY", "Value": "${qc_memory_mb}" }
                  ]
                }
              },
              "ResultPath": "$.batch_params",
              "Next": "Quality_Control"
            },
            "Quality_Control": {
              "Type": "Task",
              "Resource": "arn:aws:states:::batch:submitJob.sync",
              "Parameters": {
                "JobName.$": "$.batch_params.JobName",
                "JobDefinition": "${job_definition}",
                "JobQueue": "${job_queue}",
                "ContainerOverrides.$": "$.batch_params.ContainerOverrides",
                "Timeout": { "AttemptDurationSeconds": 3600 }
              },
              "Retry": [
                {
                  "ErrorEquals": ["Batch.AWSBatchException", "Batch.ServerException"],
                  "IntervalSeconds": 10,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "ResultSelector": { "JobId.$": "$.JobId", "Status.$": "$.Status" },
              "ResultPath": "$.batch_output",
              "End": true
            }
          }
        },
        {
          "StartAt": "Choose_Aligner",
          "States": {
            "Prepare_Align_Command": {
              "Type": "Pass",
              "Parameters": {
                "JobName.$": "States.Format('AlignGenome-{}-{}', $.srr_id, $$.Execution.Name)",
                "JobDefinition": "${job_definition}",
                "ContainerOverrides": {
                  "Command.$": "States.Array('python', 'tasks.py', 'align', $.srr_id, $.reference_name)",
                  "Environment": [{ "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" }],
                  "ResourceRequirements": [
                    { "Type": "VCPU", "Value.$": "$.run_settings.align_vcpu" },
                    { "Type": "MEMORY", "Value.$": "$.run_settings.align_memory_mb" }
                  ]
                }
              },
              "ResultPath": "$.batch_params",
              "Next": "Align_Genome"
            },
            "Align_Genome": {
              "Type": "Task",
              "Resource": "arn:aws:states:::batch:submitJob.sync",
              "Parameters": {
                "JobName.$": "$.batch_params.JobName",
                "JobDefinition.$": "$.batch_params.JobDefinition",
                "JobQueue": "${job_queue}",
                "ContainerOverrides.$": "$.batch_params.ContainerOverrides",
                "Timeout": { "AttemptDurationSeconds": 14400 }
              },
              "Retry": [
                {
                  "ErrorEquals": ["Batch.AWSBatchException", "Batch.ServerException"],
                  "IntervalSeconds": 10,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "ResultSelector": { "JobId.$": "$.JobId", "Status.$": "$.Status" },
              "ResultPath": "$.batch_output",
              "End": true
            },
            "Choose_Aligner": {
              "Type": "Choice",
              "Comment": "aligner in the input (#146): none or bwa-mem2 runs bwa-mem2 in geyser-app as before; giraffe runs vg giraffe in the geyser-giraffe image (giraffe.tf), same command, keys and size. Anything else fails the run: a misspelt aligner must not silently align with bwa-mem2.",
              "Choices": [
                { "Not": { "Variable": "$.aligner", "IsPresent": true }, "Next": "Prepare_Align_Command" },
                { "Variable": "$.aligner", "StringEquals": "bwa-mem2", "Next": "Prepare_Align_Command" },
                { "Variable": "$.aligner", "StringEquals": "giraffe", "Next": "Prepare_Giraffe_Command" }
              ],
              "Default": "Unknown_Aligner"
            },
            "Prepare_Giraffe_Command": {
              "Type": "Pass",
              "Comment": "Prepare_Align_Command in the giraffe job definition: the align stage's command, job name and size (the run's settings, overrides included), so everything downstream (and the run record's aligner) is unchanged.",
              "Parameters": {
                "JobName.$": "States.Format('AlignGenome-{}-{}', $.srr_id, $$.Execution.Name)",
                "JobDefinition": "${giraffe_job_definition}",
                "ContainerOverrides": {
                  "Command.$": "States.Array('python', 'tasks.py', 'align', $.srr_id, $.reference_name)",
                  "Environment": [{ "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" }],
                  "ResourceRequirements": [
                    { "Type": "VCPU", "Value.$": "$.run_settings.align_vcpu" },
                    { "Type": "MEMORY", "Value.$": "$.run_settings.align_memory_mb" }
                  ]
                }
              },
              "ResultPath": "$.batch_params",
              "Next": "Align_Genome"
            },
            "Unknown_Aligner": {
              "Type": "Fail",
              "Error": "UnknownAligner",
              "Cause": "aligner must be bwa-mem2 or giraffe (or left out for bwa-mem2)"
            }
          }
        }
      ],
      "ResultSelector": {
        "qc.$": "$[0].batch_output",
        "align.$": "$[1].batch_output"
      },
      "ResultPath": "$.parallel_output",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Prepare_Run_Close", "ResultPath": "$.error" }
      ],
      "Next": "Choose_Caller"
    },
    "Choose_Caller": {
      "Type": "Choice",
      "Comment": "caller = deepvariant (set by the trigger from Terraform's default_caller, or in a manual start) runs DeepVariant on the GPU queue; anything else, or no caller, runs bcftools as before (regions planned, called in parallel, merged).",
      "Choices": [
        {
          "And": [
            { "Variable": "$.caller", "IsPresent": true },
            { "Variable": "$.caller", "StringEquals": "deepvariant" }
          ],
          "Next": "Prepare_DeepVariant_Command"
        }
      ],
      "Default": "Prepare_Plan_Command"
    },
    "Prepare_DeepVariant_Command": {
      "Type": "Pass",
      "Parameters": {
        "JobName.$": "States.Format('DeepVariant-{}-{}', $.srr_id, $$.Execution.Name)",
        "ContainerOverrides": {
          "Command.$": "States.Array('/opt/geyser-venv/bin/python', 'deepvariant_task.py', $.srr_id, $.reference_name)",
          "Environment": [
            { "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" },
            { "Name": "PIPELINE_CALLER", "Value": "deepvariant" }
          ]
        }
      },
      "ResultPath": "$.batch_params",
      "Next": "DeepVariant"
    },
    "DeepVariant": {
      "Type": "Task",
      "Comment": "Linear DeepVariant on the GPU (variants_deepvariant/{id}.vcf.gz). If it fails for any reason, bcftools calls the sample instead (the scatter-gather path), and $.deepvariant_error records why. pangenome-aware runs hang when call_variants runs out of GPU memory (app-deepvariant/README.md), so the attempt has a hard limit.",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Parameters": {
        "JobName.$": "$.batch_params.JobName",
        "JobDefinition": "${deepvariant_job_definition}",
        "JobQueue": "${gpu_job_queue}",
        "ContainerOverrides.$": "$.batch_params.ContainerOverrides",
        "Timeout": { "AttemptDurationSeconds": 3600 }
      },
      "Retry": [
        {
          "ErrorEquals": ["Batch.AWSBatchException", "Batch.ServerException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": { "JobId.$": "$.JobId", "Status.$": "$.Status" },
      "ResultPath": "$.batch_output",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Prepare_Plan_Command", "ResultPath": "$.deepvariant_error" }
      ],
      "Next": "Prepare_Gate_Command"
    },
    "Prepare_Plan_Command": {
      "Type": "Pass",
      "Comment": "Plans the variant-calling regions (tasks.py regions) after QC and align. Its own step, not a Parallel branch: Step Functions Local re-applies a branch's retry interval when sibling branches finish during its back-off, which made the retry tests flaky. The window is the run's ($.run_settings, set before any job), the same one the merge uses.",
      "Parameters": {
        "JobName.$": "States.Format('PlanRegions-{}-{}', $.srr_id, $$.Execution.Name)",
        "ContainerOverrides": {
          "Command.$": "States.Array('python', 'tasks.py', 'regions', $.reference_name, '--window', $.run_settings.variant_region_window, '--output-key', States.Format('intermediate/variant-regions/{}/{}.json', $.srr_id, $$.Execution.Name))",
          "Environment": [{ "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" }],
          "ResourceRequirements": [
            { "Type": "VCPU", "Value": "${plan_vcpu}" },
            { "Type": "MEMORY", "Value": "${plan_memory_mb}" }
          ]
        }
      },
      "ResultPath": "$.batch_params",
      "Next": "Plan_Regions"
    },
    "Plan_Regions": {
      "Type": "Task",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Parameters": {
        "JobName.$": "$.batch_params.JobName",
        "JobDefinition": "${job_definition}",
        "JobQueue": "${job_queue}",
        "ContainerOverrides.$": "$.batch_params.ContainerOverrides",
        "Timeout": { "AttemptDurationSeconds": 1800 }
      },
      "Retry": [
        {
          "ErrorEquals": ["Batch.AWSBatchException", "Batch.ServerException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": { "JobId.$": "$.JobId", "Status.$": "$.Status" },
      "ResultPath": "$.plan_output",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Prepare_Run_Close", "ResultPath": "$.error" }
      ],
      "Next": "Read_Regions"
    },
    "Read_Regions": {
      "Type": "Task",
      "Comment": "The regions the planner wrote, read straight from S3 (no Lambda) and parsed into a list for the Map.",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "${bucket}",
        "Key.$": "States.Format('intermediate/variant-regions/{}/{}.json', $.srr_id, $$.Execution.Name)"
      },
      "ResultSelector": { "regions.$": "States.StringToJson($.Body)" },
      "ResultPath": "$.plan",
      "Retry": [
        { "ErrorEquals": ["S3.S3Exception", "States.Timeout"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Prepare_Run_Close", "ResultPath": "$.error" }
      ],
      "Next": "Call_Variant_Shards"
    },
    "Call_Variant_Shards": {
      "Type": "Map",
      "Comment": "Scatter: one variants --region job per region, at most variants_max_concurrency at a time. Each writes intermediate/variant-parts/<id>/<RUN_NAME>/ (expired by #62's lifecycle rule).",
      "ItemsPath": "$.plan.regions",
      "Parameters": {
        "srr_id.$": "$.srr_id",
        "reference_name.$": "$.reference_name",
        "region.$": "$$.Map.Item.Value",
        "index.$": "$$.Map.Item.Index"
      },
      "MaxConcurrency": ${variants_max_concurrency},
      "Iterator": {
        "StartAt": "Prepare_Shard_Command",
        "States": {
          "Prepare_Shard_Command": {
            "Type": "Pass",
            "Parameters": {
              "JobName.$": "States.Format('CallVariantsShard-{}-{}', $.index, $$.Execution.Name)",
              "ContainerOverrides": {
                "Command.$": "States.Array('python', 'tasks.py', 'variants', $.srr_id, $.reference_name, '--region', $.region)",
                "Environment": [{ "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" }],
                "ResourceRequirements": [
                  { "Type": "VCPU", "Value": "${variants_vcpu}" },
                  { "Type": "MEMORY", "Value": "${variants_memory_mb}" }
                ]
              }
            },
            "ResultPath": "$.batch_params",
            "Next": "Call_Shard"
          },
          "Call_Shard": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
              "JobName.$": "$.batch_params.JobName",
              "JobDefinition": "${job_definition}",
              "JobQueue": "${job_queue}",
              "ContainerOverrides.$": "$.batch_params.ContainerOverrides",
              "Timeout": { "AttemptDurationSeconds": 7200 }
            },
            "Retry": [
              {
                "ErrorEquals": ["Batch.AWSBatchException", "Batch.ServerException"],
                "IntervalSeconds": 10,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "ResultSelector": { "JobId.$": "$.JobId", "Status.$": "$.Status" },
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Prepare_Run_Close", "ResultPath": "$.error" }
      ],
      "Next": "Prepare_Variants_Command"
    },
    "Prepare_Variants_Command": {
      "Type": "Pass",
      "Parameters": {
        "JobName.$": "States.Format('CallVariants-{}-{}', $.srr_id, $$.Execution.Name)",
        "ContainerOverrides": {
          "Command.$": "States.Array('python', 'tasks.py', 'variants', $.srr_id, $.reference_name, '--window', $.run_settings.variant_region_window)",
          "Environment": [{ "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" }],
          "ResourceRequirements": [
            { "Type": "VCPU", "Value": "${merge_vcpu}" },
            { "Type": "MEMORY", "Value": "${merge_memory_mb}" }
          ]
        }
      },
      "ResultPath": "$.batch_params",
      "Next": "Call_Variants"
    },
    "Call_Variants": {
      "Type": "Task",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Parameters": {
        "JobName.$": "$.batch_params.JobName",
        "JobDefinition": "${job_definition}",
        "JobQueue": "${job_queue}",
        "ContainerOverrides.$": "$.batch_params.ContainerOverrides",
        "Timeout": { "AttemptDurationSeconds": 7200 }
      },
      "Retry": [
        {
          "ErrorEquals": ["Batch.AWSBatchException", "Batch.ServerException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": { "JobId.$": "$.JobId", "Status.$": "$.Status" },
      "ResultPath": "$.batch_output",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Prepare_Run_Close", "ResultPath": "$.error" }
      ],
      "Next": "Prepare_Gate_Command"
    },
    "Prepare_Gate_Command": {
      "Type": "Pass",
      "Comment": "The quality gate (#144) on whichever caller ran. The job runs with GATE_MODE=warn (pinned here, whatever the job definition or the app default says), so a failed verdict never fails the job itself: it stores qc_reports/{id}.gate.json, and the states below decide. Mode is Terraform's gate_mode. The image must have the gate (main from #148 on).",
      "Parameters": {
        "Mode": "${gate_mode}",
        "JobName.$": "States.Format('QualityGate-{}-{}', $.srr_id, $$.Execution.Name)",
        "ContainerOverrides": {
          "Command.$": "States.Array('python', 'tasks.py', 'gate', $.srr_id)",
          "Environment": [
            { "Name": "RUN_NAME", "Value.$": "$$.Execution.Name" },
            { "Name": "GATE_MODE", "Value": "warn" },
            { "Name": "GATE_CONFIG", "Value.$": "States.Format('$GATE_THRESHOLDS_DIR/{}.toml', $.gate_profile)" }
          ],
          "ResourceRequirements": [
            { "Type": "VCPU", "Value": "${qc_vcpu}" },
            { "Type": "MEMORY", "Value": "${qc_memory_mb}" }
          ]
        }
      },
      "ResultPath": "$.batch_params",
      "Next": "Quality_Gate"
    },
    "Quality_Gate": {
      "Type": "Task",
      "Comment": "Parses a few small files: seconds of work, so a short attempt limit (the app's own limit for the binary is 300 s).",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Parameters": {
        "JobName.$": "$.batch_params.JobName",
        "JobDefinition": "${job_definition}",
        "JobQueue": "${job_queue}",
        "ContainerOverrides.$": "$.batch_params.ContainerOverrides",
        "Timeout": { "AttemptDurationSeconds": 900 }
      },
      "Retry": [
        {
          "ErrorEquals": ["Batch.AWSBatchException", "Batch.ServerException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": { "JobId.$": "$.JobId", "Status.$": "$.Status" },
      "ResultPath": "$.gate_output",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Gate_Problem", "ResultPath": "$.gate_error" }
      ],
      "Next": "Read_Gate_Verdict"
    },
    "Read_Gate_Verdict": {
      "Type": "Task",
      "Comment": "The verdict the job stored, read straight from S3 like Read_Regions. A missing or unreadable verdict is a gate problem, not a quality failure.",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "${bucket}",
        "Key.$": "States.Format('qc_reports/{}.gate.json', $.srr_id)"
      },
      "ResultSelector": { "verdict.$": "States.StringToJson($.Body)" },
      "ResultPath": "$.gate",
      "Retry": [
        { "ErrorEquals": ["S3.S3Exception", "States.Timeout"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Gate_Problem", "ResultPath": "$.gate_error" }
      ],
      "Next": "Gate_Verdict_Readable"
    },
    "Gate_Verdict_Readable": {
      "Type": "Choice",
      "Comment": "A verdict without a 'verdict' field (not the gate's JSON, or not an object) would make the comparisons below fail the run with States.Runtime and no notification: it is a gate problem instead. Presence tests never throw.",
      "Choices": [{ "Variable": "$.gate.verdict.verdict", "IsPresent": true, "Next": "Gate_Decision" }],
      "Default": "Gate_Problem"
    },
    "Gate_Decision": {
      "Type": "Choice",
      "Comment": "pass: done. fail (with its reasons): the mode decides. Anything else (verdict null: the gate couldn't judge) is a gate problem.",
      "Choices": [
        { "Variable": "$.gate.verdict.verdict", "StringEquals": "pass", "Next": "Pipeline_Succeeded" },
        {
          "And": [
            { "Variable": "$.gate.verdict.verdict", "StringEquals": "fail" },
            { "Variable": "$.gate.verdict.reasons", "IsPresent": true }
          ],
          "Next": "Gate_Failed"
        }
      ],
      "Default": "Gate_Problem"
    },
    "Gate_Failed": {
      "Type": "Choice",
      "Comment": "gate_mode = fail: the run fails with the gate's reasons. warn (the default until a handful of real runs pass cleanly, #157): recorded, the run succeeds.",
      "Choices": [{ "Variable": "$.batch_params.Mode", "StringEquals": "fail", "Next": "Prepare_Gate_Failure" }],
      "Default": "Gate_Warned"
    },
    "Prepare_Gate_Failure": {
      "Type": "Pass",
      "Comment": "The failure path like any failed stage's (Prepare_Run_Close closes the run record as failed, Notify_Failure publishes $.error): here the gate's named reasons.",
      "Parameters": {
        "Error": "QualityGateFailed",
        "Cause.$": "States.Format('{} failed the quality gate: {} (verdict: qc_reports/{}.gate.json)', $.srr_id, States.JsonToString($.gate.verdict.reasons), $.srr_id)"
      },
      "ResultPath": "$.error",
      "Next": "Prepare_Run_Close"
    },
    "Gate_Problem": {
      "Type": "Choice",
      "Comment": "The gate gave no verdict (its job failed, e.g. a bad GATE_CONFIG or an image without the gate; the verdict is missing, unreadable or null). warn: the run succeeds, through Gate_Skipped so it is told apart from a warned verdict. fail: no verdict is no pass.",
      "Choices": [{ "Variable": "$.batch_params.Mode", "StringEquals": "fail", "Next": "Prepare_Gate_Error" }],
      "Default": "Gate_Skipped"
    },
    "Prepare_Gate_Error": {
      "Type": "Pass",
      "Parameters": {
        "Error": "QualityGateError",
        "Cause.$": "States.Format('The quality gate gave no verdict for {}: see the QualityGate job log and qc_reports/{}.gate.json', $.srr_id, $.srr_id)"
      },
      "ResultPath": "$.error",
      "Next": "Prepare_Run_Close"
    },
    "Gate_Warned": {
      "Type": "Pass",
      "Comment": "gate_mode = warn and the gate failed the sample: recorded (qc_reports/{id}.gate.json, the run record, the job log, this execution's output) and the run still succeeds.",
      "Next": "Pipeline_Succeeded"
    },
    "Gate_Skipped": {
      "Type": "Pass",
      "Comment": "gate_mode = warn and the gate gave no verdict ($.gate_error or a null verdict says why). The run succeeds, but it was never judged: it doesn't count toward the switch to fail (#157). The QualityGate stage's FailureCount metric shows a failed gate job on the dashboard.",
      "Next": "Pipeline_Succeeded"
    },
    "Pipeline_Succeeded": {
      "Type": "Succeed",
      "Comment": "Every successful run ends here, after the quality gate."
    },
    "Prepare_Run_Close": {
      "Type": "Pass",
      "Comment": "The failure path, before the notification: the run's closing run-record part (#155), so a run whose failing job never wrote its own part (killed, out of memory, timed out, or a step outside the stages) still ends as failed. The Catch output goes in as it is; the app parses the failing stage, reason, exit code and log stream from it when the record is read (provenance._failure_of). Only fields every Catch output has, so this Pass, which can't catch, can't fail.",
      "Parameters": {
        "schema": 1,
        "task": "Finalize",
        "sample_id.$": "$.srr_id",
        "run_name.$": "$$.Execution.Name",
        "finished.$": "$$.State.EnteredTime",
        "status": "failed",
        "caught.$": "$.error"
      },
      "ResultPath": "$.run_close",
      "Next": "Close_Run_Record"
    },
    "Close_Run_Record": {
      "Type": "Task",
      "Comment": "Written straight to S3, not by a Batch job: no Fargate start-up on failure, and a retried job's Cause (every attempt's description) can be too big for a command line. Best effort: if this fails, the run still goes on to Notify_Failure with the original $.error.",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "${bucket}",
        "Key.$": "States.Format('runs/{}.provenance/Finalize.json', $.srr_id)",
        "Body.$": "States.JsonToString($.run_close)",
        "ContentType": "application/json"
      },
      "Retry": [
        { "ErrorEquals": ["S3.S3Exception", "States.Timeout"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
      ],
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Notify_Failure", "ResultPath": "$.close_error" }
      ],
      "Next": "Notify_Failure"
    },
    "Notify_Failure": {
      "Type": "Task",
      "Comment": "Even if the SNS publish itself fails, the run must still end as Failed.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${sns_topic_arn}",
        "Message": {
          "PipelineName": "Geyser Genomics Pipeline",
          "ExecutionId.$": "$$.Execution.Id",
          "Status": "FAILED",
          "ErrorDetails.$": "$.error",
          "Input.$": "$$",
          "StartTime.$": "$$.Execution.StartTime"
        },
        "MessageAttributes": {
          "Status": { "DataType": "String", "StringValue": "FAILED" },
          "Pipeline": { "DataType": "String", "StringValue": "Geyser Genomics" }
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Pipeline_Failed", "ResultPath": "$.notify_error" }
      ],
      "Next": "Pipeline_Failed"
    },
    "Pipeline_Failed": {
      "Type": "Fail",
      "Comment": "Terminal state for any failed stage, so a failed run ends as FAILED instead of SUCCEEDED after the notification is sent.",
      "Error": "PipelineStageFailed",
      "Cause": "A pipeline stage failed. See the SNS failure notification or the execution history for details."
    }
  }
}
